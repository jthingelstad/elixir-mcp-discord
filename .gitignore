node_modules/
.env
# Backups of a secrets file are still a secrets file. A `git add -A` after
# writing .env.bak swept one into a commit on 2026-09-08; GitHub's push
# protection caught it, which is not a control this repo should be relying on.
.env.*
!.env.example
# config.json is an INSTANCE's settings; the checkout ships config.example.json.
/config.json
# The bot's own backups of files it changed; only an instance has them.
.history/
agent/.history/
state/
*.log

# A private prompt bundle, for an operator who does not want their agent's
# voice in a public checkout. Point AGENT_DIR at it.
agent.local/
