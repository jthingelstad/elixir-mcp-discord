<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>__LABEL__</string>

    <!-- Absolute path to node. launchd does not read your shell profile, so a
         bare "node" is not on PATH and the job fails to spawn with a status
         nobody reads. -->
    <key>ProgramArguments</key>
    <array>
        <string>__NODE__</string>
        <string>__REPO__/src/index.js</string>
    </array>

    <!-- dotenv reads .env relative to the working directory. -->
    <key>WorkingDirectory</key>
    <string>__REPO__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <!-- launchd hands a job a minimal PATH without /opt/homebrew/bin. This
             process does not shell out today, but anything it ever spawns would
             inherit the gap, and that failure is miserable to diagnose. -->
        <key>PATH</key>
        <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- A job that dies on startup (bad token, missing .env) would otherwise be
         respawned every 10s forever. Thirty seconds keeps a real crash loop
         legible in the log instead of drowning it. -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <key>StandardOutPath</key>
    <string>__LOG__</string>
    <key>StandardErrorPath</key>
    <string>__LOG__</string>
</dict>
</plist>
