# elixir-mcp-discord — .env holds what the bot may NOT change about itself:
# the three secrets and the three wiring ids. Nothing else.
#
# Every setting the bot MAY change lives in config.json beside this file
# (config.example.json lists them with what each means). That is the rule
# that decides which file a key is in: config.json can be versioned with the
# instance, backed up under .history/ and edited from the DM with a diff you
# read; this file is never any of those things. `npm run setup -- <dir>`
# writes both.
#
# An instance from before config.json existed is migrated on its first boot:
# the settings move out, this file is rewritten to the lines below, and the
# old copy is kept under state/env-history/.

# Your AGENT's key, shown once when the agent is created at
# https://elixir.poapkings.com > Account > Agents. Only its hash is stored
# server-side; if you lose it, revoke and mint another.
ELIXIR_MCP_TOKEN=REPLACE_ME

# The bot token from Developer Portal > your application > Bot.
DISCORD_BOT_TOKEN=REPLACE_ME

ANTHROPIC_API_KEY=REPLACE_ME

# --- Wiring: not secret, not the bot's to change ---------------------------
# Your AGENT's door (Account > Agents shows the URL beside the key). Must be
# reachable from the public internet: the Claude API opens the MCP connection
# server-side. An agent key presented at the personal /mcp is refused.
ELIXIR_MCP_URL=https://elixir.poapkings.com/a/REPLACE_ME/mcp
# The Discord application (Developer Portal > New Application) and the server
# it is invited to. `npm run setup` checks the token belongs to the app id.
DISCORD_APP_ID=
DISCORD_GUILD_ID=

# Optional path overrides, environment-only because they say where an
# instance IS. Relative to this directory.
# STATE_PATH=state/state.json
# AGENT_DIR=agent
