# elixir-mcp-discord — copy to .env and fill in.
# Every value here is required unless marked optional.

# --- Elixir MCP -------------------------------------------------------------
# The MCP endpoint. Must be reachable from the public internet: the Claude API
# opens the MCP connection server-side, not from this process.
ELIXIR_MCP_URL=https://elixir.poapkings.com/mcp

# A service token minted for THIS bot — its own token, not the one elixir-bot
# uses. Two reasons it must be separate: the Admin page audits calls per token,
# so a shared token makes the two consumers indistinguishable; and revoking one
# should never take down the other.
#   Elixir MCP > Admin > Service tokens > New token, name it `elixir-mcp-discord`.
ELIXIR_MCP_TOKEN=svt_REPLACE_ME

# The clan this bot reports on, e.g. #2GUCVLQR. Used for the notifications lane.
CLAN_TAG=

# --- Discord ----------------------------------------------------------------
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# #ask-elixir-mcp — members talk to the agent here.
ASK_CHANNEL_ID=

# #elixir-mcp — the clan notifications feed.
NOTIFY_CHANNEL_ID=

# --- Claude -----------------------------------------------------------------
ANTHROPIC_API_KEY=

# Optional. Defaults shown.
# CLAUDE_MODEL=claude-sonnet-5
# CLAUDE_EFFORT=medium
# NOTIFY_POLL_SECONDS=300
# ASK_HISTORY_TURNS=8
# DAILY_USD_CAP=5.00
