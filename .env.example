# elixir-mcp-discord — every knob, documented. `npm run setup -- <dir>` writes
# the instance's .env for you and asks about the ones that matter; this file is
# the reference for the rest, which you set by hand in the instance's .env.
#
# The directory a .env sits in is the INSTANCE: the process reads .env, agent/
# and state/ from its working directory (or INSTANCE_DIR), so one checkout of
# the code can run several bots — one per clan, each with its own Discord app,
# Elixir agent and Claude key — from several directories. See README "Setup".
#
# Everything here is WIRING. What the bot says, when it says it, and what it is
# for lives in `agent/` as editable text. There is no clan in this file and no
# clan in the source: the Elixir MCP agent key already knows which clan it acts
# for, and a second copy of that fact could disagree with it.

# --- Elixir MCP -------------------------------------------------------------
# Your AGENT's door, not the personal one. Create it at
# https://elixir.poapkings.com > Account > Agents > Create agent, and the URL
# and key are shown together. An agent key presented at the personal /mcp is
# refused, and so it should be: "me" means something different at each door.
#
# Must be reachable from the public internet: the Claude API opens the MCP
# connection server-side, not from this process.
ELIXIR_MCP_URL=https://elixir.poapkings.com/a/REPLACE_ME/mcp

# Shown once, when the agent is created. Only its hash is stored, so there is
# no way to recover it later — if you lose it, revoke and mint another.
ELIXIR_MCP_TOKEN=REPLACE_ME

# --- Discord ----------------------------------------------------------------
# One application per bot: Developer Portal > New Application. `npm run setup`
# checks the token belongs to this id, that the Message Content intent is on,
# and prints the invite link if the bot is not in the server yet.
DISCORD_APP_ID=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Where the bot LISTENS: the ask channel, where members' messages are answered
# in threads. This is the one channel binding that stays explicit.
#
# Where it POSTS is not configured here at all: every channel where its role is
# explicitly granted Send Messages is in its directory, and the model chooses
# among them by name and topic. A routine may name a default with `channel:`,
# bound here as CHANNEL_<NAME> or simply matched by channel name.
CHANNEL_ASK=

# --- Claude -----------------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Budgets ----------------------------------------------------------------
# TWO POTS, because two different people spend them.
#
# MONTHLY_BUDGET_USD covers what the bot does on its own — scheduled posts and
# event briefs. That cost is a function of the routines YOU wrote, so it is
# predictable and it is yours.
#
# ASK_MONTHLY_BUDGET_USD covers what clan members ask for. That cost is a
# function of how talkative the channel is, which nobody decides in advance.
# On one shared pot, a busy afternoon silently cancels tomorrow's 01:00 post
# and the only symptom is silence.
#
# Both are UTC calendar months and neither rolls over. Unset means unlimited,
# which the boot log will warn about rather than let you assume.
#
# These are STRICT: a lane refuses to START a turn that could take it past the
# line, using the largest turn that lane has ever produced as the estimate.
# That is why the bot can stop a little short of the number rather than a
# little past it.
MONTHLY_BUDGET_USD=20.00
ASK_MONTHLY_BUDGET_USD=10.00

# What one turn is assumed to cost before this install has seen one. The real
# figure climbs to the largest turn each lane produces; this is only the floor.
# TURN_RESERVE_USD=0.30

# An extra ceiling on top of the monthly budgets. Unset means no daily cap.
# DAILY_USD_CAP=5.00

# --- Optional. Defaults shown. ----------------------------------------------
# Schedules in agent/routines/*.md are written in THIS zone. UTC is the safe
# default; set your own and "22:00" means your evening, DST included.
# TIMEZONE=UTC

# YOUR CHOICE OF MODEL, for every routine that does not name its own. Any
# Claude model works; a routine can override both in its own front matter, so a
# cheap nudge and a weekly deep report need not cost the same.
#
# Whatever you pick must have a price in agent/models.json (or in the catalog
# shipped in src/pricing.js), because a model we cannot price is one the
# budgets above cannot enforce. An unpriced model stops the bot at boot rather
# than quietly billing zero.
# CLAUDE_MODEL=claude-sonnet-5
# CLAUDE_EFFORT=medium
# CLAUDE_MAX_TOKENS=8000

# How often to read the event feed. Every poll is a metered call against your
# own daily budget, and the feed is empty most of the time; the hub's docs
# say hourly is plenty. Lower it if you want joins and departures posted
# within minutes and have the calls to spare.
# EVENT_POLL_SECONDS=1800

# Where the prompts live, relative to this file. The default is the agent/
# directory beside it.
# AGENT_DIR=agent

# Where cursors, the run ledger and spend are kept, relative to this file.
# STATE_PATH=state/state.json

# Prefix for the slash commands. Several bots on one server each register
# their own /run, and Discord tells them apart only by avatar in the picker;
# COMMAND_PREFIX=pk makes this one's /pk-run, /pk-budget and /pk-routines.
# COMMAND_PREFIX=

# Turn routines off by key, no file edit: `/run` still works on them.
# ROUTINES_DISABLED=meta-report,pilot-spotlight

# Discord user ids allowed to use the admin slash commands (/run, /routines,
# /budget). Everything they do costs money, so this is an allow-list rather
# than a role check; Discord's own permissions only decide who SEES them.
# ADMIN_USER_IDS=

# Logical channel for maintainer replies to feedback this agent filed.
# Defaults to the first event routine's default channel, else the first
# channel in the directory.
# FEEDBACK_CHANNEL=general

# How many post_message calls one turn may make. Default 3.
# MAX_POSTS_PER_TURN=3

# On boot the bot posts one small line — online, build, Elixir MCP contract,
# what it runs — in the first channel it may post in, at most once an hour.
# STARTUP_MESSAGE=off
