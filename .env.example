# elixir-mcp-discord — .env holds SECRETS and nothing else.
#
# Every other setting lives in config.json beside this file (see
# config.example.json for all of them with what each means). That split is
# deliberate: config.json can be versioned with the instance, backed up under
# .history/ and edited from the DM with a diff you read; this file is never
# any of those things. `npm run setup -- <dir>` writes both.
#
# An instance from before config.json existed is migrated on its first boot:
# the settings move out, this file is rewritten to the lines below, and the
# old copy is kept under state/env-history/.

# Your AGENT's key, shown once when the agent is created at
# https://elixir.poapkings.com > Account > Agents. Only its hash is stored
# server-side; if you lose it, revoke and mint another.
ELIXIR_MCP_TOKEN=REPLACE_ME

# The bot token from Developer Portal > your application > Bot.
DISCORD_BOT_TOKEN=REPLACE_ME

ANTHROPIC_API_KEY=REPLACE_ME

# Optional path overrides, environment-only because they say where an
# instance IS. Relative to this directory.
# STATE_PATH=state/state.json
# AGENT_DIR=agent
